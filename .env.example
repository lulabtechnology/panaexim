# Public website URL. Replace after the final domain is connected.
NEXT_PUBLIC_SITE_URL=https://panaexim.example

# Supabase > Project Settings > API / Connect
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only. Never expose this value in browser code or commit it to GitHub.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Fallback directory password used only until a password is saved from the admin panel.
PARTICIPANTS_ACCESS_PASSWORD=replace-with-a-strong-temporary-password

# Generate both secrets with: openssl rand -base64 48
PARTICIPANTS_SESSION_SECRET=replace-with-at-least-32-random-characters
PARTICIPANTS_RATE_LIMIT_SECRET=replace-with-another-random-secret
